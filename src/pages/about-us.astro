---
import ImgAndTextList from '@components/organisms/ImgAndTextList/ImgAndTextList.astro';
import { info } from '@data/about-us';
import BeltLayout from '@layouts/BeltLayout.astro';
import Layout from '@layouts/Layout.astro';
---

<Layout pageTitle="Lily Pub | Sobre Nosotros">
  <BeltLayout topSpace="big">
    <h1
      class="font-secondary text-secondary tracking-wider text-xl text-center underline md:text-3xl"
    >
      Sobre Nosotros
    </h1>

    <ImgAndTextList data={info} />
  </BeltLayout>
</Layout>
