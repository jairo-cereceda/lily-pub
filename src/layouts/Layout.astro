---
import FictionalPopup from '@components/organisms/FictionalPopup/FictionalPopup.astro';
import Footer from '@components/organisms/Footer/Footer.astro';
import Header from '@components/organisms/Header/Header.astro';

import '@styles/main.css';

export interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/media/favicon.png" />
    <meta name="robots" content="noindex" />
    <meta name="generator" content={Astro.generator} />

    <meta
      property="og:title"
      content="Lily Pub | El pub playero donde empieza la noche"
    />
    <meta
      property="og:description"
      content="Cócteles, música y atardeceres frente al mar."
    />
    <meta property="og:image" content="/media/favicon.png" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Lily Pub | El pub playero donde empieza la noche"
    />
    <meta
      name="twitter:description"
      content="Cócteles, música y atardeceres frente al mar."
    />
    <meta name="twitter:image" content="/media/favicon.png" />

    <title>{pageTitle || 'Lily Pub'}</title>
  </head>
  <body class="flex flex-col justify-between min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-100 focus:bg-white"
      >Ir al contenido principal</a
    >
    <Header />
    <main class="flex flex-col gap-10" id="main">
      <slot />
    </main>
    <FictionalPopup />
    <Footer />
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fictionalPopup = document.querySelector(
      '#fictional-popup'
    ) as HTMLDialogElement;

    const fictionalPopupOpeners = document.querySelectorAll(
      '[data-open-fictional-popup]'
    );

    const fictionalPopupClose = document.querySelector(
      '#fictional-popup-close'
    );

    const openDialog = () => {
      fictionalPopup.showModal();
      document.body.classList.add('overflow-hidden');
      fictionalPopup.focus();
    };

    const closeDialog = () => {
      document.body.classList.remove('overflow-hidden');

      fictionalPopup.classList.add(
        'opacity-0',
        'scale-95',
        'transition-all',
        'duration-200'
      );

      setTimeout(() => {
        fictionalPopup.close();

        fictionalPopup.classList.remove(
          'opacity-0',
          'scale-95',
          'transition-all',
          'duration-200'
        );
      }, 200);
    };

    fictionalPopupClose?.addEventListener('click', () => {
      closeDialog();
    });

    fictionalPopup.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeDialog();
    });

    fictionalPopup.addEventListener('click', (e: MouseEvent) => {
      if (!(e.target instanceof HTMLElement)) return;

      if (!e.target.closest('#fictional-popup-content')) {
        closeDialog();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDialog();
    });

    fictionalPopupOpeners.forEach((btn) => {
      btn.addEventListener('click', openDialog);
    });
  });
</script>

<script>
  const setupScrollReveal = () => {
    const targets = document.querySelectorAll(
      '[data-info-block]'
    ) as NodeListOf<HTMLElement>;

    const observerOptions = {
      root: null,
      threshold: 0.3,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('translate-x-[50%]');
          entry.target.classList.remove('translate-x-[-50%]');
          entry.target.classList.remove('opacity-0');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    targets.forEach((target) => observer.observe(target));
  };

  window.addEventListener('load', () => {
    setupScrollReveal();
  });
</script>
