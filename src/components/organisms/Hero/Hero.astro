---
export interface heroData {
  title: string;
  url?: string;
  urlTitle?: string;
  video: string;
}

export interface Props {
  data: heroData;
}

const { data } = Astro.props;
const { title, url, urlTitle, video } = data;
---

<div class="relative w-full h-[80vh]">
  <video
    loop
    autoplay
    muted
    playsinline
    preload="auto"
    class="w-full h-full object-cover"
  >
    <source src={video} type="video/mp4" />
  </video>

  <div
    class="absolute w-full h-full top-0 left-0 bg-black-light z-20 flex justify-center items-center flex-col gap-4 lg:gap-8"
  >
    <h1 class="text-2xl font-secondary text-white tracking-wider lg:text-4xl">
      {title}
    </h1>
    {
      url && urlTitle && (
        <a
          href={url}
          class="rounded-xl bg-detail p-2 text-white border lg:border-2 border-white cursor-pointer lg:text-xl lg:font-semibold lg:p-4 lg:px-6
          transition-colors duration-200 hover:border-detail-light active:border-detail-light hover:border-2"
        >
          {urlTitle}
        </a>
      )
    }
  </div>
</div>
